# 标题
VITE_APP_TITLE=意象点餐管理系统

# 项目本地运行端口号
VITE_PORT=80

# open 运行 npm run dev 时自动打开浏览器
VITE_OPEN=true

# 请求路径：npm run dev 走 development 模式，只读 .env，故本地后端地址需在此声明
# 各打包模式（dev/test/stage/prod）的同名配置优先级更高，不会受影响
VITE_BASE_URL='http://localhost:48081'
VITE_API_URL=/admin-api
VITE_UPLOAD_TYPE=server
VITE_UPLOAD_URL='http://localhost:48081/admin-api/infra/file/upload'

# 租户开关
VITE_APP_TENANT_ENABLE=false

# 验证码的开关：需与后端 yshop.captcha.enable 保持一致，后端为 true 时此处必须为 true
VITE_APP_CAPTCHA_ENABLE=true

# 文档地址的开关
VITE_APP_DOCALERT_ENABLE=true

# 百度统计
VITE_APP_BAIDU_CODE = a1ff8825baa73c3a78eb96aa40325abc

# 百度地图ak
VITE_BAIDU_MAP_AK = m1YRfvvQt9dPVNuPSieTEDgRhZkIznSn
